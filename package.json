{
  "name": "astroworldmc.js",
  "version": "1.1.0",
  "description": "A TypeScript npm wrapper for the AstroWorldMC API!",
  "license": "ISC",
  "author": "schle1m",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "Minecraft Api", "Api wrapper", "typed", "Minecraft Data" 
  ],
  "repository": {"type": "git", "url": "https://github.com/schle1m/astroWorldMc.js.git"},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test --test-reporter=./test/test-reporter.cjs",
    "test:unit": "npm run build && node --test --test-reporter=./test/test-reporter.cjs test/unit/*.test.cjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}